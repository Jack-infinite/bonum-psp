{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Editor + test config. `tsconfig.lib.json` re-checks src with declaration rules.
    "types": ["node"],
    // Tests and config files emit no declarations.
    "isolatedDeclarations": false,
    "declaration": false
  },
  "include": ["src", "test", "*.config.ts"]
}
