{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!pnpm-lock.yaml"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noDefaultExport": "error",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/sdk/src/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "suspicious": { "noConsole": "error" }
        }
      }
    },
    {
      "includes": ["packages/mcp/src/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error"] } } }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.mjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["skills/**/SKILL.md", "CODE_OF_CONDUCT.md"],
      "formatter": { "enabled": false }
    }
  ]
}
